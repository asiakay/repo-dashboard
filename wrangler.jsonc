{
  "name": "repo-dashboard",
  "compatibility_date": "2025-11-19",
  "pages_build_output_dir": "./public",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repo-dashboard-work-items",
      "database_id": "321045e5-1e2c-4a29-a837-f5e9ff1b6502"
    }
  ],
  // Local dev secrets: copy .dev.vars.example → .dev.vars and fill in values.
  // wrangler pages dev picks up .dev.vars automatically.
  // Production secrets are set via: wrangler secret put <NAME>
  // or Cloudflare Pages dashboard → Settings → Environment variables.
  //
  // Variables consumed by the functions:
  //   GITHUB_TOKEN      – raises GitHub API rate limit from 60 → 5000 req/hr
  //   CF_ACCESS_TEAM_DOMAIN – Access team domain, e.g. "myteam.cloudflareaccess.com"
  //   CF_ACCESS_AUD         – Access application Audience (AUD) tag
  //                           Together these enable verification of Cf-Access-Jwt-Assertion.
  //                           When set, write endpoints and /api/mcp fail closed.
  //   WRITE_TOKEN       – bearer token for write endpoints (open only when this AND Access are unset)
  //   MCP_SECRET_TOKEN  – bearer token for /api/mcp (open only when this AND Access are unset)
  //   CF_API_TOKEN      – Cloudflare API token (Access: Service Tokens: Edit permission)
  //                       used by list/create/rotate/delete_service_token MCP tools
  //   CF_ACCOUNT_ID     – Cloudflare account ID (visible in CF dashboard sidebar)
  "vars": {}
}
